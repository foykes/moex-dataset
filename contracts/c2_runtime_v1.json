{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mds.c2.runtime/1",
  "title": "C2 runtime wire contract version 1",
  "description": "Closed data codec only. Caller-retained bindings are inputs, never authority created by this document. Validation confers no source proof, quality admission or publication status.",
  "x-digest-profile": "SHA256_CANONICAL_JSON_UTF8_SORTED_COMPACT_V1",
  "x-semantics": [
    "Strict UTF-8 JSON, unique object keys, no bare or overflowing nonfinite numbers, no lone surrogate strings.",
    "Exact four-field context; candidate_release_id is separate. No context.release_id alias.",
    "Canonical content digest hashes [columns, typed rows]; bindings digest hashes ordered bindings.",
    "Caller-retained producer/source/evidence/canonical/previous identities are compared independently of payload claims.",
    "Caller supplies evaluation time and independent source acquisition window; canonical as_of is not acquisition time.",
    "Nullable fields require exactly matching closed null_reasons; null never proves absence.",
    "No ticket, registry, authority, network, clock or I/O is created by the codec."
  ],
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "mds.c2.runtime"
    },
    "schema_version": {
      "const": 1
    },
    "schema_sha256": {
      "$ref": "#/$defs/digest"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "candidate_release_id": {
      "$ref": "#/$defs/alias"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "canonical": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/canonical"
        }
      ]
    },
    "source_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "previous": {
      "$ref": "#/$defs/previous"
    },
    "assessment": {
      "$ref": "#/$defs/assessment"
    },
    "null_reasons": {
      "type": "object",
      "properties": {
        "canonical": {
          "enum": [
            "NOT_AVAILABLE",
            "NOT_APPLICABLE"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "schema_sha256",
    "context",
    "candidate_release_id",
    "producer",
    "canonical",
    "source_bindings",
    "evidence",
    "previous",
    "assessment",
    "null_reasons"
  ],
  "additionalProperties": false,
  "$defs": {
    "alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "context": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/alias"
        },
        "snapshot_id": {
          "$ref": "#/$defs/alias"
        },
        "dataset_id": {
          "$ref": "#/$defs/alias"
        },
        "as_of": {
          "$ref": "#/$defs/utc"
        }
      },
      "required": [
        "run_id",
        "snapshot_id",
        "dataset_id",
        "as_of"
      ],
      "additionalProperties": false
    },
    "role": {
      "enum": [
        "SOURCE_WORKER",
        "E_VERIFIER",
        "Q_ASSESSOR",
        "K_IDENTITY"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "producer_id": {
          "$ref": "#/$defs/alias"
        },
        "profile_id": {
          "$ref": "#/$defs/alias"
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "profile_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "role",
        "producer_id",
        "profile_id",
        "profile_version",
        "profile_sha256"
      ],
      "additionalProperties": false
    },
    "cell": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "NULL"
            },
            "value": {
              "type": "null"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "BOOL"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "INT"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "FLOAT64"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "TEXT"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "NONFINITE"
            },
            "value": {
              "enum": [
                "NAN",
                "POS_INF",
                "NEG_INF"
              ]
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "$ref": "#/$defs/alias"
        },
        "acquisition_id": {
          "$ref": "#/$defs/alias"
        },
        "source_kind": {
          "enum": [
            "MOEX_ISS",
            "DOHOD",
            "SYNTHETIC_ONLY"
          ]
        },
        "raw_sha256": {
          "$ref": "#/$defs/digest"
        },
        "raw_length": {
          "$ref": "#/$defs/count"
        },
        "acquired_at": {
          "$ref": "#/$defs/utc"
        },
        "contract_evidence_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/alias"
            }
          ]
        },
        "coverage_evidence_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/alias"
            }
          ]
        },
        "null_reasons": {
          "type": "object",
          "properties": {
            "contract_evidence_ref": {
              "enum": [
                "NOT_AVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "coverage_evidence_ref": {
              "enum": [
                "NOT_AVAILABLE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "source_id",
        "acquisition_id",
        "source_kind",
        "raw_sha256",
        "raw_length",
        "acquired_at",
        "contract_evidence_ref",
        "coverage_evidence_ref",
        "null_reasons"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/alias"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "candidate_release_id": {
          "$ref": "#/$defs/alias"
        },
        "source_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/alias"
            }
          ]
        },
        "subject_sha256": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "HISTORICAL_ONLY",
            "SYNTHETIC_ONLY",
            "NOT_VERIFIED",
            "CONFLICTED"
          ]
        },
        "assessor_role": {
          "$ref": "#/$defs/role"
        },
        "assessor_id": {
          "$ref": "#/$defs/alias"
        },
        "profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/utc"
        },
        "valid_until": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/utc"
            }
          ]
        },
        "null_reasons": {
          "type": "object",
          "properties": {
            "source_id": {
              "enum": [
                "NOT_AVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "valid_until": {
              "enum": [
                "NOT_AVAILABLE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "evidence_id",
        "context",
        "candidate_release_id",
        "source_id",
        "subject_sha256",
        "status",
        "assessor_role",
        "assessor_id",
        "profile_sha256",
        "created_at",
        "valid_until",
        "null_reasons"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "canonical_ordinal": {
          "$ref": "#/$defs/count"
        },
        "source_id": {
          "$ref": "#/$defs/alias"
        },
        "source_ordinal": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "canonical_ordinal",
        "source_id",
        "source_ordinal"
      ],
      "additionalProperties": false
    },
    "canonical_descriptor": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "columns": {
          "const": [
            "ISIN",
            "TRADE_CODE",
            "dt",
            "value",
            "currency"
          ]
        },
        "row_count": {
          "$ref": "#/$defs/count"
        },
        "content_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bindings_sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "context",
        "columns",
        "row_count",
        "content_sha256",
        "bindings_sha256"
      ],
      "additionalProperties": false
    },
    "canonical": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "columns": {
          "const": [
            "ISIN",
            "TRADE_CODE",
            "dt",
            "value",
            "currency"
          ]
        },
        "row_count": {
          "$ref": "#/$defs/count"
        },
        "content_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bindings_sha256": {
          "$ref": "#/$defs/digest"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/$defs/cell"
              },
              {
                "$ref": "#/$defs/cell"
              },
              {
                "$ref": "#/$defs/cell"
              },
              {
                "$ref": "#/$defs/cell"
              },
              {
                "$ref": "#/$defs/cell"
              }
            ],
            "minItems": 5,
            "maxItems": 5
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      },
      "required": [
        "context",
        "columns",
        "row_count",
        "content_sha256",
        "bindings_sha256",
        "rows",
        "bindings"
      ],
      "additionalProperties": false
    },
    "previous": {
      "type": "object",
      "properties": {
        "presence": {
          "enum": [
            "PRESENT",
            "ABSENT",
            "NOT_VERIFIED"
          ]
        },
        "previous_release_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/alias"
            }
          ]
        },
        "previous_snapshot_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/alias"
            }
          ]
        },
        "previous_as_of": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/utc"
            }
          ]
        },
        "evidence_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/alias"
            }
          ]
        },
        "null_reasons": {
          "type": "object",
          "properties": {
            "previous_release_id": {
              "enum": [
                "NOT_AVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "previous_snapshot_id": {
              "enum": [
                "NOT_AVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "previous_as_of": {
              "enum": [
                "NOT_AVAILABLE",
                "NOT_APPLICABLE"
              ]
            },
            "evidence_ref": {
              "enum": [
                "NOT_AVAILABLE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "presence",
        "previous_release_id",
        "previous_snapshot_id",
        "previous_as_of",
        "evidence_ref",
        "null_reasons"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "#/$defs/alias"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_VERIFIED"
          ]
        },
        "evidence_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/alias"
            }
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "MISSING_EVIDENCE",
                "UNVERIFIED_EVIDENCE",
                "LOCAL_INVALID",
                "SOURCE_UNAVAILABLE",
                "COVERAGE_UNKNOWN",
                "DECISION_REQUIRED",
                "NOT_APPLICABLE"
              ]
            }
          ]
        }
      },
      "required": [
        "check_id",
        "status",
        "evidence_ref",
        "reason"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL",
            "NOT_VERIFIED",
            "NEEDS_DECISION"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      },
      "required": [
        "status",
        "checks"
      ],
      "additionalProperties": false
    },
    "trusted": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "candidate_release_id": {
          "$ref": "#/$defs/alias"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "canonical": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/canonical_descriptor"
            }
          ]
        },
        "source_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "previous": {
          "$ref": "#/$defs/previous"
        },
        "evaluation_as_of": {
          "$ref": "#/$defs/utc"
        },
        "acquisition_window": {
          "type": "object",
          "properties": {
            "start": {
              "$ref": "#/$defs/utc"
            },
            "end": {
              "$ref": "#/$defs/utc"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "context",
        "candidate_release_id",
        "producer",
        "canonical",
        "source_bindings",
        "evidence",
        "previous",
        "evaluation_as_of",
        "acquisition_window"
      ],
      "additionalProperties": false
    }
  }
}
